# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git 에 올라가지 않는다.
#
# 주의: 무료 티어는 입출력이 모델 개선에 사용될 수 있다.
#       공개 문서로만 테스트하고 비공개 데이터를 넣지 않는다.
#       키가 노출되면 즉시 폐기하고 재발급한다.

# Google AI Studio 에서 발급 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 선택 — 비우면 src/d0c_sight/llm/config.py 의 기본값을 쓴다.
# D0C_LLM_MODEL=gemini-3.7-flash
# D0C_LLM_FALLBACKS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.1-flash-lite
# D0C_LLM_THINKING_BUDGET=0
