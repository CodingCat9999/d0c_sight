      "question": "PostgreSQL 11.6 standby 에서 ERROR: canceling statement due to conflict with recovery 가 계속 난다",
      "version": "18.6",
      "case_type": "error",
      "search_axis": "keyword_only",
      "gold_chunks": [
        {
          "chunk_id": "runtime-config-replication#RUNTIME-CONFIG-REPLICATION-STANDBY:5",
          "content_sha256": "f370198a453dcf5d"
